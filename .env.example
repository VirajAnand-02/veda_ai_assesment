# --- AI models -------------------------------------------------------------
# Format: "<provider>:<model id>". Providers: deepseek, openrouter, groq, openai,
# google, anthropic, gateway (Vercel AI Gateway) and compatible (any
# OpenAI-compatible API, below). Only the first ":" splits provider and model,
# so ids like "openrouter:nvidia/nemotron-3-ultra-550b-a55b:free" work.
#
# AI_MODEL does question/answer extraction, mapping and grading (text only).
# AI_VISION_MODEL finds and describes drawings (and tables) on scanned pages,
# so it must accept images. PDFs with a real text layer (typed papers) don't
# need it.
AI_MODEL=deepseek:deepseek-v4-flash
AI_VISION_MODEL=deepseek:deepseek-v4-flash-vision-exp

# --- Reading scanned pages -------------------------------------------------
# Which reader grading uses for scans/photos (typed PDFs always use their text
# layer). Both give line boxes plus one "[table: …]" line per table and one
# "[diagram: …]" line per drawing:
#   nemotron-v1 - NVIDIA's hosted Nemotron OCR v1 (NVIDIA_API_KEY). Nothing to
#                 run locally; best handwriting text in the tests. (default)
#   paddle-llm  - PaddleOCR on the local OCR server
#                 (python OCR_server/ocr_server.py start).
# In both, a table is a grid in the OCR's cell boxes that NVIDIA page-elements
# (when NVIDIA_API_KEY is set) or AI_VISION_MODEL also calls a table; its rows
# come from the cells. Drawings are found and described by AI_VISION_MODEL.
# ~5-40 s per page; the vision model is the slow part.
AI_OCR_ENGINE=nemotron-v1
# Raise contrast (x1.3) and brightness (+15) before a page is read: on | off (default).
# On the test answer sheets (clean scans) it made no overall difference; it's for
# dim or grey phone photos.
AI_OCR_ENHANCE=off
# Box convention asked of the vision model when it boxes drawings: auto picks the
# model's native one (DeepSeek [x1,y1,x2,y2] 0-999, Gemini [y1,x1,y2,x2] 0-1000,
# others x-first 0-1000).
AI_VISION_BOX_FORMAT=auto

# --- Keys ----------------------------------------------------------------------
# Only the keys for the providers you use are needed.
DEEPSEEK_API_KEY=
# NVIDIA: Nemotron OCR + page-elements (build.nvidia.com). The base URL can point
# at a self-hosted NIM instead.
NVIDIA_API_KEY=
# NVIDIA_OCR_BASE_URL=https://ai.api.nvidia.com/v1/cv/nvidia
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=

# Optional OpenAI-compatible provider, used as "compatible:<model id>".
# e.g. NVIDIA NIM: base URL https://integrate.api.nvidia.com/v1, the NVIDIA_API_KEY
# value as the key, and AI_MODEL=compatible:nvidia/nemotron-3-ultra-550b-a55b.
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_API_KEY=
# JSON-schema output is sent by default; set off for an endpoint that rejects it.
# OPENAI_COMPATIBLE_STRUCTURED_OUTPUTS=on

# --- PaddleOCR (for AI_OCR_ENGINE=paddle-llm) -----------------------------------
# The local server in ./OCR_server listens here by default.
# PADDLE_OCR_URL=http://127.0.0.1:8090/paddle
# PADDLE_OCR_API_KEY=   (only if OCR_API_KEY is set in OCR_server/.env)

# --- Supabase (Project Settings -> API Keys) --------------------------------
# The URL and publishable key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only (never prefix with NEXT_PUBLIC_). Used to read uploaded
# pages back for the OCR and vision models.
SUPABASE_SECRET_KEY=

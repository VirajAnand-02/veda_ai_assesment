# --- AI models -------------------------------------------------------------
# Format: "<provider>:<model id>". Providers: deepseek, openrouter, openai, google,
# anthropic, gateway (Vercel AI Gateway) and compatible (any OpenAI-compatible API,
# below). Only the first ":" splits provider and model, so ids like
# "openrouter:nvidia/nemotron-3-ultra-550b-a55b:free" work.
#
# AI_MODEL does question/answer extraction, mapping and grading (text only).
# AI_VISION_MODEL reads scanned pages and photos, so it must accept images.
# PDFs with a real text layer (typed papers) don't need the vision model.
AI_MODEL=deepseek:deepseek-v4-flash
AI_VISION_MODEL=deepseek:deepseek-v4-flash-vision-exp

# --- Reading scanned pages -------------------------------------------------
# Which reader grading uses for scans/photos (typed PDFs always use their text layer).
#
# Recommended (best in the /ocr comparison; both give line boxes plus one
# "[table: …]" line per table and one "[diagram: …]" line per drawing):
#   nemotron-v1 - NVIDIA's hosted Nemotron OCR v1 (NVIDIA_API_KEY). Nothing to run
#             locally; best handwriting text in the tests.
#   paddle-llm - PaddleOCR on the local OCR server (python OCR_server/ocr_server.py start).
# In both, a table is a grid in the OCR's cell boxes that NVIDIA page-elements
# (when NVIDIA_API_KEY is set) or AI_VISION_MODEL also calls a table; its rows
# come from the cells. Drawings are found and described by AI_VISION_MODEL.
# ~5-40 s per page; the vision model is the slow part.
#
# Others:
#   llm     - AI_VISION_MODEL reads text and boxes (default; needs only DEEPSEEK_API_KEY)
#   hunyuan - HunyuanOCR (./OCR_server) reads text; very precise boxes, no diagrams
#   hybrid  - HunyuanOCR text + its layout finds diagrams + AI_VISION_MODEL
#             describes each diagram. Needs the OCR server running.
#   paddle  - PaddleOCR text only: ~2-5 s per page on CPU, precise boxes, weaker
#             on handwriting than HunyuanOCR.
#   nemotron-v2 - like nemotron-v1 with Nemotron OCR v2 (misread more handwriting).
#   mistral - Mistral's hosted OCR (MISTRAL_API_KEY); paragraph-level boxes.
AI_OCR_ENGINE=llm
# Raise contrast (x1.3) and brightness (+15) before a page is read: on | off (default).
# On the test answer sheets (clean scans) it made no overall difference; it's for
# dim or grey phone photos.
AI_OCR_ENHANCE=off
# Box convention asked of the vision LLM: auto picks the model's native one
# (DeepSeek [x1,y1,x2,y2] 0-999, Gemini [y1,x1,y2,x2] 0-1000, others x-first 0-1000).
AI_VISION_BOX_FORMAT=auto
# Send each page as N overlapping horizontal strips (1-4). DeepSeek caps an image
# at 1024 tokens, so strips give it more detail per line: on a typed test page,
# mean box IoU went from ~0.15 (1 strip) to ~0.55 (3 strips). Costs N calls per page.
AI_VISION_TILES=3

# Only the keys for the providers you use are needed.
DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# OPENAI_API_KEY=
# GOOGLE_GENERATIVE_AI_API_KEY=
# ANTHROPIC_API_KEY=
# AI_GATEWAY_API_KEY=

# Optional OpenAI-compatible provider, used as "compatible:<model id>".
# e.g. NVIDIA NIM: base URL https://integrate.api.nvidia.com/v1, the NVIDIA_API_KEY
# value as the key, and AI_MODEL=compatible:nvidia/nemotron-3-ultra-550b-a55b.
# OPENAI_COMPATIBLE_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_COMPATIBLE_API_KEY=
# JSON-schema output is sent by default; set off for an endpoint that rejects it.
# OPENAI_COMPATIBLE_STRUCTURED_OUTPUTS=on

# --- HunyuanOCR (only for the /ocr comparison page) -----------------------
# Any OpenAI-compatible server running tencent/HunyuanOCR. The local server in
# ./OCR_server (python OCR_server/ocr_server.py start) listens on port 8090;
# a vLLM server or hosted provider works too.
# HUNYUAN_OCR_BASE_URL=http://127.0.0.1:8090/v1
# HUNYUAN_OCR_API_KEY=
# HUNYUAN_OCR_MODEL=tencent/HunyuanOCR
# HUNYUAN_OCR_MAX_TOKENS=4096

# --- PaddleOCR ---------------------------------------------------------------
# Defaults to the /paddle route on the same server as HUNYUAN_OCR_BASE_URL
# (and HUNYUAN_OCR_API_KEY). Set only if PaddleOCR runs somewhere else.
# PADDLE_OCR_URL=http://127.0.0.1:8090/paddle
# PADDLE_OCR_API_KEY=

# --- Groq (a second vision LLM column on /ocr) ------------------------------------
# Any Groq model that accepts images, read like AI_VISION_MODEL. GROQ_API_KEY also
# enables "groq:<model id>" for AI_MODEL / AI_VISION_MODEL.
# GROQ_API_KEY=
# GROQ_OCR_MODEL=qwen/qwen3.8-27b
# Strips per page. Keep 1 on the free tier: qwen/qwen3.8-27b allows ~8k input and
# only ~1k output tokens per minute, and one page needs ~2k in and 1.5-2.5k out.
# GROQ_OCR_TILES=1
# GROQ_OCR_BOX_FORMAT=auto

# --- NVIDIA Nemotron OCR (v1 and v2 columns on /ocr) ------------------------------
# Key from build.nvidia.com. The base URL can point at a self-hosted NIM instead.
# NVIDIA_API_KEY=
# NVIDIA_OCR_BASE_URL=https://ai.api.nvidia.com/v1/cv/nvidia

# --- Mistral OCR ---------------------------------------------------------------
# Hosted OCR API (https://docs.mistral.ai/api/endpoint/ocr), billed per page.
# Returns markdown text plus paragraph-level block boxes.
# MISTRAL_API_KEY=
# MISTRAL_OCR_MODEL=mistral-ocr-latest
# MISTRAL_BASE_URL=https://api.mistral.ai/v1

# --- Supabase (Project Settings -> API Keys) --------------------------------
# The URL and publishable key are safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key: server only (never prefix with NEXT_PUBLIC_). Used to read uploaded
# pages back for the vision model.
SUPABASE_SECRET_KEY=

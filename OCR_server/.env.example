# PaddleOCR server settings. Copy to .env and adjust. Environment variables
# with the same names override this file.

# 127.0.0.1 = only this machine. Use 0.0.0.0 to accept LAN connections
# (then set OCR_API_KEY).
OCR_HOST=127.0.0.1
OCR_PORT=8090
# Optional bearer token clients must send (the app's PADDLE_OCR_API_KEY).
OCR_API_KEY=

# Model preset: v6-small (default), v6-tiny, v6-medium (cleaner text, ~4x slower),
# v5-mobile-en.
OCR_PADDLE_MODEL=v6-small

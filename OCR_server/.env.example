# HunyuanOCR server settings. Copy to .env and adjust. Environment variables
# with the same names override this file.

# --- Device ---------------------------------------------------------------
# cpu (default) or gpu.
OCR_DEVICE=cpu
# GPU backend on Windows/Linux: vulkan (default, small download, any vendor)
# or cuda (NVIDIA only, ~650 MB extra download). macOS always uses Metal.
OCR_GPU_BACKEND=vulkan
# Which GPU to use, e.g. Vulkan1 or CUDA0. Empty = pick the dedicated GPU.
# List them with: python ocr_server.py info   (with OCR_DEVICE=gpu)
OCR_GPU_DEVICE=
# Layers to put on the GPU: all, auto, or a number (lower it if VRAM runs out).
OCR_GPU_LAYERS=all

# --- PaddleOCR --------------------------------------------------------------
# A /paddle/ocr route next to HunyuanOCR: PP-OCR detection + recognition via
# RapidOCR on the CPU (~2-5 s per page). Setup installs it into .venv (~260 MB).
OCR_PADDLE=on
# v6-small (default), v6-tiny, v6-medium (cleaner text, ~4x slower), v5-mobile-en.
OCR_PADDLE_MODEL=v6-small

# --- Network --------------------------------------------------------------
# The gateway serves OCR_PORT (/v1 -> HunyuanOCR, /paddle -> PaddleOCR);
# llama-server itself listens on OCR_PORT + 1, localhost only.
# 127.0.0.1 = only this machine. Use 0.0.0.0 to accept LAN connections
# (then set OCR_API_KEY).
OCR_HOST=127.0.0.1
OCR_PORT=8090
# Optional bearer token clients must send (the app's HUNYUAN_OCR_API_KEY).
OCR_API_KEY=
# Model name the API reports; keep in sync with the app's HUNYUAN_OCR_MODEL.
OCR_MODEL_ALIAS=tencent/HunyuanOCR

# --- Model ----------------------------------------------------------------
OCR_MODEL_REPO=prithivMLmods/HunyuanOCR-1.5-GGUF-Updated
# Language model quantisation: Q8_0 (default), F16, BF16, Q5_K_M, Q4_K_M, ...
OCR_MODEL_QUANT=Q8_0
# Vision encoder quantisation: q8_0 (default), f16, bf16.
OCR_MMPROJ_QUANT=q8_0
# Pinned llama.cpp release (https://github.com/ggml-org/llama.cpp/releases).
OCR_LLAMA_BUILD=b11201
# Only needed if the model repo requires a Hugging Face login.
HF_TOKEN=

# --- Performance ----------------------------------------------------------
# Context per request (image tokens + output). A page uses about 1-3k image
# tokens. Larger values reserve more (V)RAM: on a 4 GB GPU, 16384 made image
# processing ~4x slower than 8192.
OCR_CTX_SIZE=8192
# Max output tokens per request (a dense page of lines with boxes is ~2-4k).
OCR_MAX_TOKENS=4096
# CPU threads; empty = llama.cpp default.
OCR_THREADS=
# Extra llama-server flags, space-separated.
OCR_EXTRA_ARGS=
